# Copy to .env and adjust. Never commit .env.

# ---------- Postgres (n8n storage + automation data) ----------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_local_dev
POSTGRES_DB=helpdesk

# ---------- n8n ----------
# Pinned to the version this repo was built and tested against.
N8N_VERSION=2.49.5
# Generate once, then keep it stable: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me-32-byte-hex-key
N8N_BASE_URL=http://localhost:5678
N8N_LOG_LEVEL=info
TZ=Asia/Karachi

# ---------- Helpdesk API (the real one is plugged in here later) ----------
# Local mock: http://mock-helpdesk:8080 (only reachable from containers)
HELPDESK_BASE_URL=http://mock-helpdesk:8080
HELPDESK_API_KEY=dev-helpdesk-key

# ---------- AI provider (OpenAI-compatible) ----------
# Local mock LLM until a real key/model is set:
AI_BASE_URL=http://mock-llm:8080/v1
AI_API_KEY=mock-key
AI_MODEL=mock-it-agent
# Real example:
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4.1-mini

# Optional second attempt, used only if you set a URL here.
# Empty (recommended): when the primary provider fails the ticket escalates
# straight to a human, with an "AI TRIAGE FAILED" note for IT.
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=

# ---------- Claude subscription via Claude Code (optional) ----------
# Generate a one-year token with `claude setup-token` on a machine with a
# browser, then set AI_BASE_URL=http://claude-bridge:8080/v1 to use it.
# Never commit this file. Leave empty to keep the bridge disabled (503 -> fallback).
CLAUDE_CODE_OAUTH_TOKEN=
# Optional: an API key here wins over the token and bills per token instead.
ANTHROPIC_API_KEY=
BRIDGE_TIMEOUT_MS=95000

# ---------- Where IT gets told (all optional, use any combination) ----------
# Internal notes are always written into the helpdesk. Each URL below adds a
# push notification for every ticket that needs a human, plus every approval
# request. Leave a line empty to skip that channel.
#
# Slack:       Apps -> Incoming Webhooks -> add to channel -> copy URL
IT_SLACK_WEBHOOK_URL=
# Google Chat: space -> Apps & integrations -> Webhooks -> add -> copy URL
IT_GOOGLE_CHAT_WEBHOOK_URL=
# MS Teams:    channel -> Workflows/Connectors -> Incoming Webhook -> copy URL
IT_TEAMS_WEBHOOK_URL=
# Email: any HTTP email API (Resend, Mailgun, Postmark, your own gateway).
# Fields sent: { from, to: [..], subject, text }. SMTP: use n8n's Email node instead.
IT_EMAIL_WEBHOOK_URL=
IT_EMAIL_TO=it-team@example.com
IT_EMAIL_FROM=helpdesk@example.com
# Any other gateway: receives the full record as JSON
# { kind, ticket_id, status, priority, subject, employee, report, reply }.
IT_NOTIFY_WEBHOOK_URL=

# ---------- Approval links (must be reachable by whoever clicks) ----------
APPROVAL_BASE_URL=http://localhost:5678/webhook/it-helpdesk/approval

# ---------- Local n8n owner account created by bootstrap ----------
N8N_OWNER_EMAIL=it-admin@example.com
N8N_OWNER_PASSWORD=ChangeMe12345!
N8N_OWNER_FIRST_NAME=IT
N8N_OWNER_LAST_NAME=Admin
