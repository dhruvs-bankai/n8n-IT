    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nUPDATE approvals\nSET status = $2, decided_by = $3, decided_at = now()\nWHERE id::text = $1 AND status = 'pending'\nRETURNING id, ticket_id, status, resume_url, question;",
        "options": {
          "queryReplacement": "={{ [ $('Parse Approval Request').first().json.token, $('Parse Approval Request').first().json.decision, $('Parse Approval Request').first().json.decided_by ] }}"
