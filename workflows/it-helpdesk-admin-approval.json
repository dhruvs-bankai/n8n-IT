    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nSELECT id, ticket_id, kind, question, status, resume_url,\n       (status = 'pending' AND expires_at > now()) AS usable\nFROM approvals WHERE id::text = $1 LIMIT 1;",
        "options": {
          "queryReplacement": "={{ [ $json.token ] }}"
        }
      },
