    {
      "parameters": {
        "jsCode": "\nconst q = $json.query || {};\nconst b = ($json.body && typeof $json.body === 'object') ? $json.body : {};\nconst token = String(q.token || b.token || '').trim();\nconst decision = String(q.decision || b.decision || '').toLowerCase().trim();\nconst decided_by = String(q.by || b.by || b.decided_by || 'it-admin').trim();\nconst valid = token.length >= 8 && ['approved', 'rejected'].includes(decision);\nreturn [{ json: { token, decision, decided_by, valid } }];"
      },
      "id": "parse-approval-request",
      "name": "Parse Approval Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
